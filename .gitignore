# Gradle / build output
.gradle/
build/
bin/
!gradle/wrapper/gradle-wrapper.jar
.kotlin/

# Временные файлы настроек Claude Code
.claude/settings.json.tmp.*

# Локальные пути SDK — у каждого свои
local.properties

# Android Studio / IntelliJ
.idea/
*.iml
captures/
.cxx/

# Подписи и артефакты
*.apk
*.aab
*.keystore
*.jks
# Общий debug-ключ проекта (пароль android): одна подпись со всех машин, иначе телефон не даёт обновиться
!keystore/debug.keystore

# Сессии с машины (VIN, реальные данные)
sessions/

# Python
__pycache__/
*.pyc

# OS
Thumbs.db
.DS_Store

utils

# Личные выводы по машине (не для репозитория)
known_issues/

# Локальные скрипты и настройки VS Code (запуск на телефоне, logcat, пути SDK)
.vscode/
*.ps1
